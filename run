#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"

if [ -x .venv/bin/python ]; then
  PYTHON=".venv/bin/python"
elif command -v poetry >/dev/null 2>&1; then
  PYTHON="$(poetry env info -p)/bin/python"
else
  echo "No venv found. On the server: poetry config virtualenvs.in-project true && poetry install" >&2
  exit 1
fi

clear
exec "$PYTHON" -u bot.py
