#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"

if [ -x .venv/bin/python ]; then
  PYTHON=".venv/bin/python"
elif command -v poetry >/dev/null 2>&1; then
  PYTHON="$(poetry env info -p)/bin/python"
else
  echo "No venv found. Run: poetry install --with dev" >&2
  exit 1
fi

if ! "$PYTHON" -c "import pytest" >/dev/null 2>&1; then
  echo "pytest is missing. Run: poetry install --with dev" >&2
  exit 1
fi

# Pass through any extra args, e.g. ./test -m 'not slow'  or  ./test -k skip
exec "$PYTHON" -m pytest "$@"
